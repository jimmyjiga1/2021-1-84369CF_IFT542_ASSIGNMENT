# Copy this file to .env and fill in local values. Never commit the real .env file.
DB_HOST=127.0.0.1
DB_NAME=student_reg
DB_USER=student_reg_app
DB_PASS=change-me-locally
APP_ENV=development
SESSION_LIFETIME_SECONDS=1800

# Allowlisted hosts for the URL-preview feature (comma separated, hostnames only)
URL_PREVIEW_ALLOWLIST=example.test,raw.githubusercontent.com
